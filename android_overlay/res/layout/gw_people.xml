                <ImageView android:id="@+id/p1_photo" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:visibility="gone" />
            </FrameLayout>
                <TextView android:id="@+id/p1_name" android:layout_width="56dp" android:layout_height="wrap_content" android:gravity="center" android:maxLines="1" android:ellipsize="end" android:paddingTop="3dp" android:textColor="@color/gw_text" android:textSize="11sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="3dp">
                <ImageView android:id="@+id/p1_b1" android:layout_width="28dp" android:layout_height="28dp" android:padding="6dp" android:background="@drawable/gw_btn_bg" android:visibility="gone" />
                <ImageView android:id="@+id/p1_b2" android:layout_width="28dp" android:layout_height="28dp" android:layout_marginStart="4dp" android:padding="6dp" android:background="@drawable/gw_btn_bg" android:visibility="gone" />
